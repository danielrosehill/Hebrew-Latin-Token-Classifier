{"text": "Are we going to my parents' place for chag or staying home this year?", "seed_term": "chag", "seed_category": "religious", "seed_spans": [{"start": 38, "end": 42, "surface": "chag", "term": "chag"}], "generator": "anthropic/claude-sonnet-5"}
{"text": "Honestly, cooking for chag every single time is exhausting.", "seed_term": "chag", "seed_category": "religious", "seed_spans": [{"start": 22, "end": 26, "surface": "chag", "term": "chag"}], "generator": "anthropic/claude-sonnet-5"}
