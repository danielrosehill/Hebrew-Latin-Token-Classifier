{"text": "I'm meeting Dana in tel aviv on Thursday for coffee near the beach.", "seed_term": "tel aviv", "seed_category": "places", "seed_spans": [{"start": 20, "end": 28, "surface": "tel aviv", "term": "tel aviv"}], "generator": "anthropic/claude-sonnet-5"}
