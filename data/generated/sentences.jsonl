{"text": "Moving to tel aviv next month, super excited but also kind of broke already.", "seed_term": "tel aviv", "seed_category": "places", "seed_spans": [{"start": 10, "end": 18, "surface": "tel aviv", "term": "tel aviv"}], "generator": "anthropic/claude-sonnet-5"}
{"text": "Have you paid the arnona for this quarter yet, or are we going to get another warning letter?", "seed_term": "arnona", "seed_category": "finance", "seed_spans": [{"start": 18, "end": 24, "surface": "arnona", "term": "arnona"}], "generator": "anthropic/claude-sonnet-5"}
{"text": "The arnona on this apartment is way higher than I expected, especially for such a small place.", "seed_term": "arnona", "seed_category": "finance", "seed_spans": [{"start": 4, "end": 10, "surface": "arnona", "term": "arnona"}], "generator": "anthropic/claude-sonnet-5"}
