{"text": "My daughter starts gan next week and she's so excited about it.", "seed_term": "gan", "seed_category": "education", "seed_spans": [{"start": 19, "end": 22, "surface": "gan", "term": "gan"}], "generator": "anthropic/claude-sonnet-5"}
