{"text": "Loved every minute of gan, honestly, the teachers there were amazing.", "seed_term": "gan", "seed_category": "education", "seed_spans": [{"start": 22, "end": 25, "surface": "gan", "term": "gan"}], "generator": "anthropic/claude-sonnet-5"}
{"text": "After years of thinking about it, they finally made aliyah last spring and moved to Haifa.", "seed_term": "aliyah", "seed_category": "immigration", "seed_spans": [{"start": 52, "end": 58, "surface": "aliyah", "term": "aliyah"}], "generator": "anthropic/claude-sonnet-5"}
