{"id": "g00000", "text": "Are you coming to our barbecue for yom haatzmaut this year?", "seed_term": "yom haatzmaut", "seed_category": "commemoration", "generator": "deepseek-flash", "annotator": "qwen/qwen3.8-flash", "spans": [{"start": 35, "end": 48, "surface": "yom haatzmaut", "term": "yom haatzmaut", "status": "agreed"}], "agreement": "full"}
